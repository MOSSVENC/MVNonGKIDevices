# Droidspaces / LXC kernel configuration fragment for MTK 4.14 (non-GKI)
#
# Implements Droidspaces "Non-GKI" support (official Kernel-Configuration.md)
# for the realme AndroidS common-source tree (MTK 4.14.186). Merged on top
# of arch/arm64/configs/k6853v1_64_6360_defconfig by merge-defconfig.sh.
#
# 4.14 corrections vs the 4.9 fragment (patches/droidspace/4.9/droidspace.config):
#   - CONFIG_CGROUP_NET_PRIO and CONFIG_BRIDGE_NETFILTER do exist on this
#     tree (net/Kconfig) and are pinned in the mandatory block below
#   - CONFIG_ANDROID_PARANOID_NETWORK is absent from this kernel's Kconfig
#     (merge-defconfig.sh records the absence instead of toggling it)
#
# Upstream reference:
#   https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md

# --- IPC mechanisms ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespace support ---
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- Control groups ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# --- Device filesystem ---
CONFIG_DEVTMPFS=y

# --- tmpfs xattr (NixOS/containers) ---
CONFIG_TMPFS_XATTR=y

# --- Firmware loading ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Droidspaces/LXC networking (NAT + isolation) ---
CONFIG_VETH=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- upstream non-GKI mandatory list (Step 1), pinned explicitly ---
# Source: Droidspaces-OSS Documentation/Kernel-Configuration.md, workspace
# snapshot localworkspace/mirrors/Droidspaces-OSS @2280b59 (v6.5.5).
# Symbols this kernel does not provide: ANDROID_PARANOID_NETWORK, FW_LOADER_COMPRESS, NETFILTER_XT_TARGET_MASQUERADE, NF_CONNTRACK_NETLINK
# CONFIG_SECCOMP_FILTER is def_bool y once SECCOMP=y (asserted, not pinned).
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_TABLES=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SYSCTL=y
CONFIG_TMPFS_POSIX_ACL=y
