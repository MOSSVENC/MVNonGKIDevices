# Droidspaces / LXC kernel configuration fragment for Linux 4.19 (non-GKI)
#
# This fragment implements the official Droidspaces "Non-GKI" mandatory
# configuration (Kernel-Configuration.md; applies to 3.18/4.4/4.9/4.14/4.19).
# 4.19 carries the block with its own symbol names: the masquerade entry is
# IP_NF_TARGET_MASQUERADE (NETFILTER_XT_TARGET_MASQUERADE is not a 4.x
# symbol) and the conntrack netlink entry is NF_CT_NETLINK
# (NF_CONNTRACK_NETLINK is not a 4.x symbol); FW_LOADER_COMPRESS is absent
# from 4.19 (added in 5.3).
#
# Merged on top of arch/arm64/configs/vendor/kona-perf_defconfig +
# vendor/xiaomi/sm8250-common.config + vendor/xiaomi/alioth.config
# (see scripts/merge-defconfig.sh; later same-name entries win, so the
# explicit =y here overrides stock defaults and "# CONFIG_PID_NS is not
# set"-style lines in the kona baseline).
#
# Source: https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md
# (section "Configuring Non-GKI Kernels", Step 1 Mandatory Configuration)

# --- IPC mechanisms ---
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespace support ---
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# --- Seccomp support ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Control groups support ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# --- Device filesystem support ---
CONFIG_DEVTMPFS=y

# --- Overlay filesystem support (required for volatile mode) ---
CONFIG_OVERLAY_FS=y

# --- tmpfs xattr / posix acl (NixOS support) ---
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Firmware loading support ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Droidspaces network isolation (NAT / none modes) ---
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# --- IPv6 NAT (NAT66) ---
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- macvlan mode (--net=macvlan) ---
CONFIG_MACVLAN=y

# --- legacy compat ---
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# --- Android paranoid network off (in-container networking) ---
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- user namespaces (docker "unsafe procfs" fix) ---
CONFIG_USER_NS=y
