# Droidspaces / LXC kernel configuration fragment for Linux 4.9 (non-GKI)
#
# This fragment implements Droidspaces "Non-GKI" support (official
# Kernel-Configuration.md) plus 4.9-specific corrections that were
# verified against a working sdm845 4.9.337 build (see the "reference"
# block at the bottom of this file). It is merged on top of
# vendor/xiaomi/mi845_defconfig + vendor/xiaomi/polaris.config.
#
# Apply: scripts/kconfig/merge_config.sh (see scripts/merge-defconfig.sh)
#
# 4.9 corrections vs the upstream doc:
#   - CONFIG_NF_CONNTRACK_NETLINK does not exist on 4.9 -> NF_CT_NETLINK
#   - CONFIG_NETFILTER_XT_TARGET_MASQUERADE does not exist on 4.9
#     -> IP_NF_TARGET_MASQUERADE (already =y in the mi845 baseline)
#   - CONFIG_SECCOMP_FILTER is def_bool y on 4.9 once SECCOMP=y (arch/Kconfig:
#     depends on HAVE_ARCH_SECCOMP_FILTER && SECCOMP && NET), not pinned here
#   - CONFIG_ANDROID_PARANOID_NETWORK defaults to y on this tree, so it is
#     explicitly disabled below for container networking.
#
# Upstream reference:
#   https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md

# --- IPC mechanisms ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespace support ---
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- Control groups ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y

# --- Device filesystem ---
CONFIG_DEVTMPFS=y

# --- tmpfs xattr (NixOS/containers) ---
CONFIG_TMPFS_XATTR=y

# --- Firmware loading ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Droidspaces/LXC networking (NAT + isolation) ---
CONFIG_VETH=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_BRIDGE_NETFILTER=y

# --- Android paranoid network must be off for in-container networking ---
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- upstream non-GKI mandatory list (Step 1), pinned explicitly ---
# Source: Droidspaces-OSS Documentation/Kernel-Configuration.md, workspace
# snapshot localworkspace/mirrors/Droidspaces-OSS @2280b59 (v6.5.5).
# Symbols this kernel does not provide: FW_LOADER_COMPRESS, NETFILTER_XT_TARGET_MASQUERADE, NF_CONNTRACK_NETLINK
# CONFIG_SECCOMP_FILTER is def_bool y once SECCOMP=y (asserted, not pinned).
CONFIG_BRIDGE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_TABLES=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SYSCTL=y
CONFIG_TMPFS_POSIX_ACL=y
# --- Optional Docker/runc enhancements (verified on 4.9.337 sdm845) ---
# Uncomment the block below to additionally enable Docker-friendly features.
# CONFIG_IP_VS=y
# CONFIG_IP_VS_NFCT=y
# CONFIG_IP_VS_PROTO_TCP=y
# CONFIG_IP_VS_PROTO_UDP=y
# CONFIG_IP_VS_RR=y
# CONFIG_IPVLAN=y
# CONFIG_MACVLAN=y
# CONFIG_VXLAN=y
# CONFIG_VLAN_8021Q=y
# CONFIG_DM_THIN_PROVISIONING=y
# CONFIG_CHECKPOINT_RESTORE=y
# CONFIG_NETFILTER_XT_MATCH_IPVS=y
# CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- reference (already fully verified in a working 4.9.337 build) ---
# https://github.com/Flyme66/kernel_xiaomi_sdm845_tejas101k_beryllium
# commit a643e6d96f07 "defconfig: inject LXC/Docker/DroidSpace configs"
#   -> arch/arm64/configs/beryllium_patched_defconfig (trailing block)
