diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 15aded3..51fafb9 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -1,3 +1,15 @@
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+extern struct work_struct susfs_extra_works;
+
+static inline void ksu_susfs_mark_umounted(void)
+{
+	if (!work_pending(&susfs_extra_works))
+		schedule_work(&susfs_extra_works);
+	susfs_set_current_proc_umounted();
+}
+#endif // #ifdef CONFIG_KSU_SUSFS
+
 static bool ksu_kernel_umount_enabled __read_mostly = true;
 
 static int kernel_umount_feature_get(u64 *value)
@@ -52,12 +64,20 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 	uid_t new_uid = ksu_get_uid_t(new->uid);
 	uid_t old_uid = ksu_get_uid_t(old->uid);
 
-	if (!ksu_kernel_umount_enabled)
+	if (!ksu_kernel_umount_enabled) {
+#ifdef CONFIG_KSU_SUSFS
+		ksu_susfs_mark_umounted();
+#endif // #ifdef CONFIG_KSU_SUSFS
 		return 0;
+	}
 
 	// if there isn't any module mounted, just ignore it!
-	if (!ksu_module_mounted)
+	if (!ksu_module_mounted) {
+#ifdef CONFIG_KSU_SUSFS
+		ksu_susfs_mark_umounted();
+#endif // #ifdef CONFIG_KSU_SUSFS
 		return 0;
+	}
 
 	// There are 6 scenarios:
 	// 1. Normal app: zygote -> appuid
@@ -100,6 +120,9 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 
 	revert_creds(saved);
 
+#ifdef CONFIG_KSU_SUSFS
+	ksu_susfs_mark_umounted();
+#endif // #ifdef CONFIG_KSU_SUSFS
 	return 0;
 }
 
